# Optional Google Gemini API key. Keep the real key in .env, never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Maximum number of FAIL findings sent to Gemini in one request
MAX_FINDINGS_FOR_AI=50

# AWS default region for CLI/SDK requests
AWS_DEFAULT_REGION=ap-southeast-1

# Paths are relative to the repository root unless absolute
PROWLER_OUTPUT_DIR=reports/prowler
FAIL_CSV_PATH=reports/findings_fail.csv
GEMINI_REPORT_PATH=reports/gemini_analysis.md
